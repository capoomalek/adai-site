# Connexion PostgreSQL (en local via docker-compose, en prod via Neon ou Supabase)
DATABASE_URL=postgres://adai:adai@127.0.0.1:5432/adai

# Chaîne aléatoire longue : générer avec `openssl rand -hex 32`
PAYLOAD_SECRET=

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

RESEND_API_KEY=
# Adresse d'expédition (domaine vérifié chez Resend), ex. noreply@adai.tn
EMAIL_EXPEDITEUR=
